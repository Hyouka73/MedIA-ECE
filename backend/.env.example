# ══════════════════════════════════════════════════════
# MedSys — Variables de entorno backend
# Copia este archivo como .env y rellena con tus valores
# NUNCA subas el .env real al repositorio
# ══════════════════════════════════════════════════════

APP_ENV=development
APP_NAME=MedSys-ECE
DEBUG=True

# Base de datos (Docker local)
# Usar los mismos valores que están en docker-compose.yml
DATABASE_URL=postgresql+asyncpg://MedSys_dev:CHANGE_THIS_PASSWORD@localhost:5432/MedSys_db

# JWT — genera una key segura con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_generated_jwt_secret_key_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# TOTP 2FA
TOTP_ISSUER=MedSys-ECE
# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=your_generated_fernet_encryption_key_base64

# CORS — separar por comas si hay más de una
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Seguridad
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30
