@router.get("/catalogos/cie10", response_model=CIE10ListOut)
async def buscar_cie10(
    q: str = Query(..., min_length=1, max_length=100, description="Término de búsqueda"),
    current_user: dict = Depends(get_current_user),
    db: AsyncSession = Depends(get_db),
    limit: int = Query(20, ge=1, le=50)
):
    """GET /encuentros/catalogos/cie10?q={termino} — Busca diagnósticos CIE-10
    
    ✅ Búsqueda con ILIKE en código y descripción
    ✅ Máximo 20 resultados ordenados por relevancia
    ✅ Cache TTL: 24h recomendado
    
    📎 Referencia: Doc5 — Catálogos CIE-10
    """
    diagnosticos, total = await CatalogoService.buscar_cie10(
        db=db,
        termino=q,
        limit=limit
    )
    
    return CIE10ListOut(
        diagnosticos=[
            {
                "codigo_cie": d.codigo_cie,
                "descripcion": d.descripcion
            }
            for d in diagnosticos
        ],
        total=total
    )